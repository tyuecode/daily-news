# Cloudflare Pages 响应头配置
# https://developers.cloudflare.com/pages/configuration/headers/
#
# 注意：实测本项目的线上响应里 style.css 返回 max-age=14400，
# 与该文件设置的 600 不一致，说明 Cloudflare 后台的 Browser Cache TTL
# 规则优先级高于 _headers。因此不能只依赖这里控制缓存，
# CSS/JS 一律改用带内容哈希的文件名（见 build_site.py 的 asset_url）。

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# 带内容哈希的资源：文件名变了 URL 就变，可长期强缓存
/style.*.css
  Cache-Control: public, max-age=31536000, immutable

/site.*.js
  Cache-Control: public, max-age=31536000, immutable

/favicon.*.svg
  Cache-Control: public, max-age=604800

# 不带版本号的旧路径（兼容/回退），保持可重新验证
/style.css
  Cache-Control: public, max-age=600, must-revalidate

/site.js
  Cache-Control: public, max-age=600, must-revalidate

# 音频：带内容哈希，可长期缓存
/audio/*.mp3
  Cache-Control: public, max-age=31536000, immutable

# 音频元数据（时长、哈希）随时可能重建，不能长缓存
/audio/*.json
  Cache-Control: public, max-age=0, must-revalidate

# HTML 与索引每次回源校验，保证新闻及时更新
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/archive.json
  Cache-Control: public, max-age=0, must-revalidate
